<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<title>Almanca Flashkartlar</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#f0f2f5;--card:#fff;--gold:#f5a623;--der:#4a90d9;--die:#e05a7a;--das:#3daa6e;--txt:#1a1a2e;--muted:#999;--sh:0 4px 24px rgba(0,0,0,.10);--sh2:0 8px 40px rgba(0,0,0,.16)}
body{background:var(--bg);font-family:'Nunito',sans-serif;color:var(--txt);min-height:100dvh;display:flex;flex-direction:column}
.hdr{background:#fff;border-bottom:1px solid #e8eaf0;padding:10px 16px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:99;gap:8px;box-shadow:0 2px 8px rgba(0,0,0,.06)}
.logo{font-size:.95rem;font-weight:900;color:#1a1a2e}
.logo-sub{font-size:.55rem;color:var(--muted);letter-spacing:.5px;text-transform:uppercase;margin-top:1px}
.hdr-m{flex:1;text-align:center}
.ctr{font-size:.72rem;color:#444;font-weight:700}
.prog{height:4px;background:#e8eaf0;border-radius:99px;overflow:hidden;margin:4px auto 0;max-width:160px}
.pf{height:100%;background:linear-gradient(90deg,#f5a623,#f7c55a);border-radius:99px;transition:width .3s}
.fsbtn{background:#f5a623;border:none;color:#fff;border-radius:99px;padding:5px 12px;font-size:.62rem;font-family:inherit;cursor:pointer;font-weight:700}
.legend{display:flex;gap:14px;justify-content:center;padding:7px 16px 4px;font-size:.68rem;font-weight:700;background:#fff;border-bottom:1px solid #f0f2f5}
.ldot{width:9px;height:9px;border-radius:50%;display:inline-block;margin-right:4px}
.li{display:flex;align-items:center;color:#666}
.sec-bar{display:flex;overflow-x:auto;gap:6px;padding:6px 14px 7px;background:#fff;border-bottom:1px solid #e8eaf0;scrollbar-width:none}
.sec-bar::-webkit-scrollbar{display:none}
.stab{flex-shrink:0;padding:4px 12px;border-radius:99px;border:1.5px solid #e0e3ea;background:#fff;color:#999;font-size:.65rem;font-weight:700;cursor:pointer;white-space:nowrap;-webkit-tap-highlight-color:transparent;transition:all .15s}
.stab.on{background:var(--gold);border-color:var(--gold);color:#fff}
.nav{padding:6px 14px;display:flex;align-items:center;gap:7px;justify-content:center;background:var(--bg)}
.ni{background:#fff;border:1.5px solid #e0e3ea;color:var(--txt);border-radius:8px;padding:4px 7px;font-family:inherit;font-size:.72rem;width:60px;text-align:center;font-weight:700}
.nl{font-size:.67rem;color:var(--muted);font-weight:600}
.ng{background:var(--gold);border:none;color:#fff;border-radius:8px;padding:4px 10px;font-family:inherit;font-size:.67rem;font-weight:800;cursor:pointer}
.stage{flex:1;display:flex;flex-direction:column;align-items:center;padding:8px 12px 8px}
.scene{width:100%;max-width:640px;perspective:1400px}
.cw{width:100%;height:435px;position:relative;transform-style:preserve-3d;transition:transform .5s cubic-bezier(.4,0,.2,1);cursor:pointer;-webkit-tap-highlight-color:transparent}
.cw.flip{transform:rotateY(180deg)}
.face{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;border-radius:22px;overflow:hidden;display:flex;flex-direction:column;box-shadow:var(--sh2);background:var(--card)}
.abar{height:6px;width:100%;flex-shrink:0;background:#e8eaf0}
.abar.der{background:var(--der)}
.abar.die{background:var(--die)}
.abar.das{background:var(--das)}
.em-area{display:flex;align-items:center;justify-content:center;padding:16px 20px 6px;flex-shrink:0;background:linear-gradient(180deg,#f8f9fc 0%,#fff 100%)}
.em-big{font-size:4.2rem;line-height:1;filter:drop-shadow(0 3px 10px rgba(0,0,0,.12))}
.art-badge{display:inline-flex;align-items:center;justify-content:center;border-radius:8px;padding:2px 9px;font-size:.78rem;font-weight:800;color:#fff;margin:0 auto 3px}
.art-badge.der{background:var(--der)} .art-badge.die{background:var(--die)} .art-badge.das{background:var(--das)} .art-badge.h{display:none}
.wt{font-family:'Playfair Display',serif;font-size:1.85rem;font-weight:900;color:#1a1a2e;line-height:1.18;text-align:center;padding:2px 14px 0}
.cbody{flex:1;overflow-y:auto;padding:8px 16px 12px;display:flex;flex-direction:column;gap:6px}
.cbody::-webkit-scrollbar{width:3px}
.cbody::-webkit-scrollbar-thumb{background:#ddd;border-radius:99px}
.ftip{text-align:center;font-size:.56rem;color:#ccc;font-weight:600;padding:4px 0 8px;flex-shrink:0}
.cj{font-size:.75rem;color:#999;font-style:italic;line-height:1.6;background:#f8f9fc;border-radius:8px;padding:5px 10px;border-left:3px solid #e0e3ea;font-weight:600}
.ex{font-size:.88rem;color:#2d2d3a;line-height:1.65;background:#f8f9fc;border-radius:8px;padding:7px 11px;border-left:3px solid var(--gold);font-weight:600}
.ex.fixed{background:#fffbf2;border-left-color:#f5c842;color:#665500;font-style:italic;font-size:.82rem}
.ex.bullet{background:transparent;border:none;color:#666;font-size:.8rem;padding:1px 6px;font-weight:700}
.ex.bullet::before{content:"• ";color:var(--gold);font-weight:900}
.fb2{transform:rotateY(180deg)}
.tm-area{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:14px 16px 6px;flex-shrink:0;background:linear-gradient(180deg,#f0faf5 0%,#fff 100%)}
.tm{font-family:'Playfair Display',serif;font-size:1.75rem;font-weight:900;color:#1a6b3e;line-height:1.2;text-align:center}
.td{font-size:.87rem;color:#2d2d3a;line-height:1.65;background:#f0faf5;border-radius:8px;padding:7px 11px;border-left:3px solid #2ecc71;font-weight:600}
.tpos{text-align:center;font-size:.56rem;color:#ccc;font-weight:600;padding:4px 0 8px;flex-shrink:0}
.hint{font-size:.57rem;color:#bbb;letter-spacing:.7px;text-transform:uppercase;margin-top:5px;text-align:center;font-weight:600}
.cpos{font-size:.67rem;color:#aaa;text-align:center;margin-top:3px;font-weight:700}
.btns{display:flex;gap:8px;width:100%;max-width:640px;padding:7px 0 4px}
.btn{flex:1;padding:13px 0;border:none;border-radius:14px;font-family:'Nunito',sans-serif;font-size:.87rem;font-weight:800;cursor:pointer;-webkit-tap-highlight-color:transparent;box-shadow:0 2px 8px rgba(0,0,0,.07)}
.btn:disabled{opacity:.28;cursor:default}
.btn:active:not(:disabled){transform:scale(.97);opacity:.85}
.bp,.bn{background:#fff;color:#666;border:1.5px solid #e0e3ea;max-width:105px}
.bf{background:linear-gradient(135deg,#f5a623,#f7c55a);color:#fff;box-shadow:0 4px 16px rgba(245,166,35,.32)}
.comp{display:none;flex-direction:column;align-items:center;gap:12px;padding:36px 20px;text-align:center}
.comp.on{display:flex}
.comp-h{font-family:'Playfair Display',serif;font-size:1.55rem;font-weight:900;color:#1a1a2e}
.comp-p{color:#888;max-width:300px;font-size:.9rem;font-weight:600}
.comp-btn{background:linear-gradient(135deg,#f5a623,#f7c55a);color:#fff;border:none;border-radius:14px;padding:12px 32px;font-family:inherit;font-size:.92rem;font-weight:800;cursor:pointer;box-shadow:0 4px 16px rgba(245,166,35,.32)}
</style>
</head>
<body>
<div class="hdr">
  <div><div class="logo">Almanca Flashkartlar</div><div class="logo-sub">B2-C1 &middot; 21 Bolum &middot; 1040 Kart</div></div>
  <div class="hdr-m"><div class="ctr" id="ctr">-</div><div class="prog"><div class="pf" id="pf" style="width:0%"></div></div></div>
  <button class="fsbtn" id="fsbtn" onclick="toggleFS()">Tam Ekran</button>
</div>
<div class="legend">
  <div class="li"><span class="ldot" style="background:var(--der)"></span>der</div>
  <div class="li"><span class="ldot" style="background:var(--die)"></span>die</div>
  <div class="li"><span class="ldot" style="background:var(--das)"></span>das</div>
</div>
<div class="sec-bar" id="secBar"></div>
<div class="nav">
  <span class="nl">Kart:</span>
  <input class="ni" id="ni" type="number" min="1" onkeydown="if(event.key==='Enter')goTo()">
  <button class="ng" onclick="goTo()">Git</button>
  <span class="nl" id="nt"></span>
</div>
<div class="stage">
  <div class="scene" id="scene">
    <div class="cw" id="card" onclick="doFlip()">
      <div class="face" id="fFront">
        <div class="abar" id="ab1"></div>
        <div class="em-area"><div class="em-big" id="emEl">📖</div></div>
        <div style="text-align:center;padding:0 0 4px"><div class="art-badge h" id="abadge"></div></div>
        <div class="wt" id="wtEl"></div>
        <div class="cbody" id="deB"></div>
        <div class="ftip">Turkce icin cevir ↓</div>
      </div>
      <div class="face fb2">
        <div class="abar" id="ab2"></div>
        <div class="tm-area">
          <div class="em-big" id="emEl2" style="font-size:2.4rem;margin-bottom:6px">📖</div>
          <div class="tm" id="tmEl"></div>
        </div>
        <div class="cbody" id="trB"></div>
        <div class="tpos" id="tpos"></div>
      </div>
    </div>
    <div class="hint">Tikla / Bosluk = cevir &nbsp;·&nbsp; ← → veya kaydır = gecis</div>
  </div>
  <div class="cpos" id="cpos"></div>
  <div class="btns" id="btns">
    <button class="btn bp" id="bP" onclick="goPrev()">← Onceki</button>
    <button class="btn bf" onclick="doFlip()">↺ Cevir</button>
    <button class="btn bn" id="bN" onclick="goNext()">Sonraki →</button>
  </div>
  <div class="comp" id="comp">
    <div style="font-size:3rem">🎉</div>
    <div class="comp-h">Bolum Tamamlandi!</div>
    <div class="comp-p" id="cMsg"></div>
    <button class="comp-btn" id="cBtn">Devam →</button>
  </div>
</div>
<script>
var D=[{"s":1,"emoji":"🔧","dt":"instandgesetzt","dc":"instandsetzen (er setzt instand – er setzte instand – er hat instandgesetzt)","de":"Das Auto wurde instandgesetzt und fährt wieder einwandfrei.","tm":"onarılmış, tamir edilmiş","td":"Araba onarıldı ve tekrar sorunsuz çalışıyor.\ninstand = çalışır durumda →\ninstandgesetzt = çalışır duruma\ngetirilmiş","art":""},{"s":1,"emoji":"🤝","dt":"Gegenseitigkeit","dc":"","de":"Eine gute Beziehung basiert auf Gegenseitigkeit.","tm":"karşılıklılık","td":"İyi bir ilişki karşılıklılığa dayanır","art":""},{"s":1,"emoji":"✋","dt":"unterbrechen","dc":"er unterbricht – er unterbrach – er hat unterbrochen","de":"Bitte unterbrechen Sie mich nicht während der Präsentation!","tm":"- Kesmek, ara vermek","td":"Lütfen sunum sırasında sözümü kesmeyin!","art":""},{"s":1,"emoji":"🧠","dt":"nachvollziehen","dc":"er vollzieht nach – er vollzog nach – er hat nachvollzogen","de":"Ich versuche, deine Perspektive nachzuvollziehen.","tm":"anlamak / mantığını kavramak/ bir süreci adım adım takip etmek","td":"Bakış açını anlamaya çalışıyorum.","art":""},{"s":1,"emoji":"⚙️","dt":"ausgeklügelten","dc":"","de":"• bein ausgeklügeltes System\n• ein ausgeklügelter Plan\n• eine ausgeklügelte Strategie\nDas Unternehmen hat ein ausgeklügeltes System entwickelt.","tm":"çok iyi düşünülmüş","td":"Şirket çok iyi düşünülmüş bir sistem geliştirdi.","art":""},{"s":1,"emoji":"🎁","dt":"eine beliebte Geschenkoption","dc":"","de":"Gutscheine sind eine beliebte\nGeschenkoption zu Weihnachten.","tm":"popüler / tercih (sevilen) edilen bir hediye seçeneği","td":"Hediye çekleri Noel’de popüler bir hediye seçeneğidir.","art":""},{"s":1,"emoji":"✅","dt":"gelingen (dativ)","dc":"es gelingt – es gelang – es ist gelungen","de":"Das Experiment ist mir endlich gelungen!","tm":"- Başarmak, başarılı olmak","td":"Deney sonunda bana başarılı oldu (daha doğal: Deneyi sonunda başardım)","art":""},{"s":1,"emoji":"🎭","dt":"sich verhalten","dc":"er verhält sich – er verhielt sich – er hat sich verhalten","de":"Er verhält sich sehr seltsam in letzter Zeit.","tm":"- Davranmak","td":"Son zamanlarda çok garip davranıyor.","art":""},{"s":1,"emoji":"😟","dt":"befürchten","dc":"er befürchtet – er befürchtete – er hat befürchtet","de":"Ich befürchte, dass wir zu spät kommen. .","tm":"- Korkmak, endişelenmek (Çok geç kalacağımızdan korkuyorum","td":"","art":""},{"s":1,"emoji":"📰","dt":"erscheinen","dc":"er erscheint – er erschien – er ist erschienen","de":"Das neue Buch erscheint nächste Woche.","tm":"- Görünmek, yayınlanmak","td":"Yeni kitap gelecek hafta yayınlanıyor.","art":""},{"s":1,"emoji":"📦","dt":"benötigen","dc":"er benötigt – er benötigte – er hat benötigt","de":"Ich benötige mehr Zeit für dieses Projekt.","tm":"ihtiyaç duymak","td":"Bu proje için daha fazla zamana ihtiyacım var.","art":""},{"s":1,"emoji":"🔗","dt":"gehören zu","dc":"","de":"Stress gehört zum Alltag.\nSie gehören zum Jahresende und\nJahresanfang wie Weihnachtsbaum und Geschenke.","tm":"bir şeyin doğal parçası olmak / ayrılmaz bir parçası olmak","td":"Stres günlük hayatın bir parçasıdır.\nOnlar, yıl sonu ve yıl başına; tıpkı\nNoel ağacı ve hediyelerin Noel’e ait olması gibi, ayrılmaz şekilde aittir.","art":""},{"s":1,"emoji":"🔘","dt":"auf Knopfdruck","dc":"","de":"Mit dieser Maschine kann man\nKaffee auf Knopfdruck zubereiten.","tm":"tek tuşla / düğmeye basınca / anında Knopf = düğme •  Druck = basma / basınç → auf Knopfdruck = düğmeye basarak","td":"Bu makineyle kahve tek tuşla hazırlanabilir.","art":""},{"s":1,"emoji":"✔️","dt":"erledigen","dc":"er erledigt – er erledigte – er hat erledigt","de":"Ich muss noch viele Aufgaben erledigen.","tm":"- Halletmek, tamamlamak","td":"Daha birçok görevi halletmem gerekiyor.","art":""},{"s":1,"emoji":"📖","dt":"basieren +auf+ D","dc":"er basiert – er basierte – er hat basiert","de":"Die Entscheidung basiert auf aktuellen Daten\nEine gute Beziehung basiert auf Vertrauen.","tm":"dayanmak / temel almak / esas almak","td":"Karar güncel verilere dayanıyor.\nİyi bir ilişki güvene dayanır","art":""},{"s":1,"emoji":"🤲","dt":"Großzügigkeit","dc":"","de":"Großzügigkeit zeigt sich nicht nur im Geld, sondern auch in der Zeit.","tm":"= cömertlik","td":"Cömertlik sadece parada değil, zamanda da kendini gösterir.","art":""},{"s":1,"emoji":"⭐","dt":"bedeutend","dc":"","de":"Das war ein bedeutender Tag in meinem Leben.","tm":"- Önemli, anlamlı","td":"Hayatımda önemli bir gündü.","art":""},{"s":1,"emoji":"🌱","dt":"nachhaltig","dc":"","de":"Wir brauchen nachhaltige\nLösungen für die Umwelt.","tm":"- Sürdürülebilir, kalıcı","td":"Çevre için sürdürülebilir çözümlere ihtiyacımız var.","art":""},{"s":1,"emoji":"👤","dt":"Verwendung von + Dativ","dc":"","de":"die Verwendung von Technologie\nDas Gerät ist bereits in Verwendung.\nDie Verwendung von Technologie erleichtert unser Leben.","tm":"kullanım teknolojinin kullanımı Cihaz zaten kullanımda. Teknolojinin kullanımı hayatımızı kolaylaştırır","td":"","art":"die"},{"s":1,"emoji":"📋","dt":"beantragen","dc":"er beantragt – er beantragte – er hat beantragt","de":"Ich habe einen neuen Pass beantragt.","tm":"- Başvurmak, talep etmek","td":"Yeni pasaport için başvurdum.","art":""},{"s":1,"emoji":"✅","dt":"Gelingen","dc":"","de":"Das Gelingen des Projekts hängt von guter Planung ab.","tm":"= başarıyla gerçekleşme, sonuç verme → Projenin başarıyla gerçekleşmesi iyi planlamaya bağlıdır. gelingen ≈ erfolgreich sein (başarılı olmak)","td":"","art":"das"},{"s":1,"emoji":"📖","dt":"aufwendig","dc":"","de":"Das war sehr aufwendig, aber es hat sich gelohnt.\nDas kostet viel Zeit und Mühe.\n(konusma dili)","tm":"= zahmetli, çok emek isteyen","td":"Çok zahmetliydi ama değdi → Çok zaman ve emek istiyor.","art":""},{"s":1,"emoji":"📖","dt":"opfern","dc":"er opfert – er opferte – er hat geopfert","de":"Er hat viel Zeit für seine Familie geopfert.","tm":"feda etmek","td":"Ailesi için çok zaman feda etti.","art":""},{"s":1,"emoji":"⚖️","dt":"vergleichen","dc":"er vergleicht – er verglich – er hat verglichen",