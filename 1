  var dB=document.getElementById('deB');dB.innerHTML='';
  if(c.dc&&c.dc.trim())dB.appendChild(mk('cj',c.dc));
  if(c.de&&c.de.trim()){
    var ls=c.de.split('\n').map(function(l){return l.trim();}).filter(Boolean);
    var ss=[],os=[];
    ls.forEach(function(l){var cl=lc(l);if(cl==='ex')ss.push(l);else os.push(l);});
    os.forEach(function(l){var cl=lc(l);dB.appendChild(mk(cl,cl==='ex bullet'?l.replace(/^[\u2022\u00b7\*]\s*/,''):l));});
    if(ss.length)dB.appendChild(mk('ex',ss.join(' | ')));
  }
  document.getElementById('tmEl').textContent=c.tm||'';
  var tB=document.getElementById('trB');tB.innerHTML='';
  if(c.td&&c.td.trim())c.td.split('\n').forEach(function(l){l=l.trim();if(l)tB.appendChild(mk('td',l));});
  document.getElementById('tpos').textContent='Bolum '+cs+' · '+(li+1)+' / '+tot;
  document.getElementById('cpos').textContent='Bolum '+cs+' · Kart '+(li+1)+' / '+tot;
  document.getElementById('pf').style.width=((gi+1)/D.length*100)+'%';
  document.getElementById('ctr').textContent='Bolum '+cs+' · '+(li+1)+'/'+tot;
  document.getElementById('ni').value=li+1;
  document.getElementById('nt').textContent='/ '+tot;
  document.getElementById('bP').disabled=(li===0);
  document.getElementById('bN').disabled=(li>=tot-1);
  renderTabs();
}
function renderTabs(){
  var bar=document.getElementById('secBar');bar.innerHTML='';
  K.forEach(function(s){
    var t=mk('stab'+(s===cs?' on':''),'B'+s+' ('+S[s].length+')');
    t.onclick=function(){cs=s;gi=S[s][0];show();render();};
    bar.appendChild(t);
  });
  var a=bar.querySelector('.on');if(a)a.scrollIntoView({behavior:'smooth',block:'nearest',inline:'center'});
}
function goTo(){var v=parseInt(document.getElementById('ni').value,10),a=sa();if(v>=1&&v<=a.length){gi=a[v-1];render();}}
function doFlip(){fl=!fl;document.getElementById('card').classList.toggle('flip',fl);}
function goNext(){
  var a=sa(),li=a.indexOf(gi);
  if(li<a.length-1){gi=a[li+1];render();return;}
  document.getElementById('scene').style.display='none';
  document.getElementById('btns').style.display='none';
  document.getElementById('cpos').style.display='none';
  document.getElementById('comp').classList.add('on');
  var ni=K.indexOf(cs)+1,ns=K[ni];
  if(ns){document.getElementById('cMsg').textContent=a.length+' kelime tamam! Bolum '+ns+' basliyor.';document.getElementById('cBtn').textContent='Bolum '+ns+' →';document.getElementById('cBtn').onclick=function(){cs=ns;gi=S[ns][0];show();render()};}
  else{document.getElementById('cMsg').textContent='Tum 21 bolumu tamamladin!';document.getElementById('cBtn').textContent='Bastan Basla';document.getElementById('cBtn').onclick=function(){cs=K[0];gi=0;show();render()};}
}
function goPrev(){var a=sa(),li=a.indexOf(gi);if(li>0){gi=a[li-1];render();return;}if(K.indexOf(cs)>0){var ps=K[K.indexOf(cs)-1];cs=ps;gi=S[ps][S[ps].length-1];render();}}
function show(){document.getElementById('scene').style.display='';document.getElementById('btns').style.display='';document.getElementById('cpos').style.display='';document.getElementById('comp').classList.remove('on');}
function toggleFS(){if(!fsM){var el=document.documentElement;if(el.requestFullscreen)el.requestFullscreen();else if(el.webkitRequestFullscreen)el.webkitRequestFullscreen();document.getElementById('fsbtn').textContent='Cik';fsM=true;}else{if(document.exitFullscreen)document.exitFullscreen();else if(document.webkitExitFullscreen)document.webkitExitFullscreen();document.getElementById('fsbtn').textContent='Tam Ekran';fsM=false;}}
document.addEventListener('fullscreenchange',function(){if(!document.fullscreenElement){fsM=false;document.getElementById('fsbtn').textContent='Tam Ekran';}});
document.addEventListener('webkitfullscreenchange',function(){if(!document.webkitFullscreenElement){fsM=false;document.getElementById('fsbtn').textContent='Tam Ekran';}});
var tx=0,ty=0;
document.getElementById('scene').addEventListener('touchstart',function(e){tx=e.touches[0].clientX;ty=e.touches[0].clientY;},{passive:true});
document.getElementById('scene').addEventListener('touchend',function(e){var dx=e.changedTouches[0].clientX-tx,dy=e.changedTouches[0].clientY-ty;if(Math.abs(dx)>Math.abs(dy)&&Math.abs(dx)>45){if(dx<0)goNext();else goPrev();}},{passive:true});
document.addEventListener('keydown',function(e){if(e.key==='ArrowRight')goNext();else if(e.key==='ArrowLeft')goPrev();else if(e.key===' '){e.preventDefault();doFlip();}});
render();
</script></body></html>
